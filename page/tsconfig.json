{
  // DOM library and no Bun or Node types, so a page module reaching for `Bun.file` or `node:fs` fails to compile.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  // The shared files the page reaches plus every shipping module of `src/lib/tracker-model/`, named one by one (its specs import `bun:test`,
  // its `testing/` is for them), so the whole model package compiles under DOM-only options, which proves it stays environment-neutral.
  "include": [
    "./**/*.ts",
    "../src/lib/tracker-model/@types/BoardChanges.ts",
    "../src/lib/tracker-model/@types/Concurrency.ts",
    "../src/lib/tracker-model/@types/Epic.ts",
    "../src/lib/tracker-model/@types/LogRecord.ts",
    "../src/lib/tracker-model/@types/TrackerProgress.ts",
    "../src/lib/tracker-model/@types/Task.ts",
    "../src/lib/tracker-model/@types/Ticket.ts",
    "../src/lib/tracker-model/Board.ts",
    "../src/lib/tracker-model/BoardRecords.ts",
    "../src/lib/tracker-model/BoardRefusal.ts",
    "../src/lib/tracker-model/DispatchQueries.ts",
    "../src/lib/tracker-model/DisplayQueries.ts",
    "../src/lib/tracker-model/Epics.ts",
    "../src/lib/tracker-model/GroupReleases.ts",
    "../src/lib/tracker-model/Logger.ts",
    "../src/lib/tracker-model/ReadingBoard.ts",
    "../src/lib/tracker-model/ReviewBars.ts",
    "../src/lib/tracker-model/TaskRows.ts",
    "../src/lib/tracker-model/TicketBodyEdits.ts",
    "../src/lib/tracker-model/TicketClaims.ts",
    "../src/lib/tracker-model/TicketDependencies.ts",
    "../src/lib/tracker-model/TicketMoves.ts",
    "../src/lib/tracker-model/TicketSettings.ts",
    "../src/lib/tracker-model/TokenCredits.ts",
    "../src/lib/tracker-model/TrackerChanges.ts",
    "../src/lib/tracker-model/constants/AgentSettings.ts",
    "../src/lib/tracker-model/constants/ConcurrencyLimits.ts",
    "../src/lib/tracker-model/constants/DispatcherStates.ts",
    "../src/lib/tracker-model/constants/EpicFields.ts",
    "../src/lib/tracker-model/constants/ReviewRounds.ts",
    "../src/lib/tracker-model/constants/Statuses.ts",
    "../src/lib/tracker-model/constants/TaskIds.ts",
    "../src/lib/tracker-model/constants/TicketFields.ts",
    "../src/lib/tracker-model/constants/TicketMoveLegality.ts",
    "../src/lib/tracker-model/utils/BoardSettingsUtil.ts",
    "../src/lib/tracker-model/utils/ConcurrencyUtil.ts",
    "../src/lib/tracker-model/utils/EmptyProgressUtil.ts",
    "../src/lib/tracker-model/utils/EpicUtil.ts",
    "../src/lib/tracker-model/utils/MarkdownBodyUtil.ts",
    "../src/lib/tracker-model/utils/TaskFilingUtil.ts",
    "../src/lib/tracker-model/utils/TaskTransitionUtil.ts",
    "../src/lib/tracker-model/utils/TicketChartUtil.ts",
    "../src/lib/tracker-model/utils/TicketDefaultsUtil.ts",
    "../src/lib/tracker-model/utils/TicketDependencyUtil.ts",
    "../src/lib/tracker-model/utils/TicketIdUtil.ts",
    "../src/lib/tracker-model/utils/TicketMoveUtil.ts",
    "../src/lib/tracker-model/utils/TicketStampUtil.ts",
    "../src/lib/tracker-model/utils/VocabularyUtil.ts",
    "../src/adapters/utils/HtmlLabelUtil.ts",
    "../src/lib/html-escape/HtmlEscapeUtil.ts",
    "../src/lib/local-time/LocalTimeUtil.ts",
    "../src/lib/token-count/TokenCountUtil.ts",
    "../src/shared/@types/PagePayload.ts",
    "../src/shared/@types/WordedProgressDocument.ts",
    "../src/shared/@types/WordedLogEntry.ts"
  ],
  // The specs and the test-only fixtures stay out, so this program's surface is the page that ships.
  "exclude": ["./**/*.spec.ts", "./testing/**"]
}
