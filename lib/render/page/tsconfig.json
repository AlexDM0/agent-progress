{
  // The page's own project: the DOM library and no Bun or Node types, so a page module reaching for
  // `Bun.file` or `node:fs` fails to compile rather than failing in a browser. Strictness is the
  // root's, inherited rather than restated.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  // The files outside this folder the page reaches, named one by one so the surface is written down in
  // one place. Naming them is not what puts them in the program — a page module's import already does,
  // and every file the imports reach is checked under the DOM-only options above, which is what proves
  // they stay environment-neutral.
  "include": [
    "./**/*.ts",
    "../../constants/Types.ts",
    "../../constants/Statuses.ts",
    "../../constants/Limits.ts",
    "../../utils/HtmlEscapeUtil.ts",
    "../../utils/TokenCountUtil.ts",
    "../../utils/TicketDependencyUtil.ts"
  ],
  // Emptied on purpose: an inherited `exclude` resolves against the root, which excludes this folder.
  "exclude": []
}
