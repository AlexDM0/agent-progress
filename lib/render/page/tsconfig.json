{
  // The page's own project: the DOM library and no Bun or Node types, so a page module reaching for
  // `Bun.file` or `node:fs` fails to compile rather than failing in a browser. Strictness is the
  // root's, inherited rather than restated.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  // The shared files the page reaches plus every non-spec module of `src/lib/tracker-model/`, named one
  // by one (no glob, as the specs import `bun:test`), so the whole model package is compiled under the
  // DOM-only options above, which is what proves it stays environment-neutral.
  "include": [
    "./**/*.ts",
    "../../../src/lib/tracker-model/@types/ProgressFile.ts",
    "../../../src/lib/tracker-model/@types/Task.ts",
    "../../../src/lib/tracker-model/@types/Ticket.ts",
    "../../../src/lib/tracker-model/constants/AgentSettings.ts",
    "../../../src/lib/tracker-model/constants/DispatcherStates.ts",
    "../../../src/lib/tracker-model/constants/Statuses.ts",
    "../../../src/lib/tracker-model/constants/TicketFields.ts",
    "../../../src/lib/tracker-model/constants/TicketMoveLegality.ts",
    "../../../src/lib/tracker-model/utils/TicketDefaultsUtil.ts",
    "../../../src/lib/tracker-model/utils/TicketDependencyUtil.ts",
    "../../../src/lib/tracker-model/utils/TicketIdUtil.ts",
    "../../../src/lib/tracker-model/utils/VocabularyUtil.ts",
    "../../../src/shared/constants/Limits.ts",
    "../../../src/lib/utils/HtmlEscapeUtil.ts",
    "../../../src/lib/utils/TokenCountUtil.ts"
  ],
  // Emptied on purpose: an inherited `exclude` resolves against the root, which excludes this folder.
  "exclude": []
}
