{
  // DOM library, React's JSX and no Bun or Node types, so a Bridge module reaching for `Bun.file` or `node:fs` fails to compile.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  // The Bridge's own modules plus the shared files it reaches, named one by one, and the whole tracker model, to prove it DOM-safe.
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/shared/constants/ProductNames.ts",
    "../src/lib/html-escape/HtmlEscapeUtil.ts",
    "../src/lib/local-time/LocalTimeUtil.ts",
    "../src/lib/token-count/TokenCountUtil.ts",
    "../src/lib/tracker-model/constants/ReviewRounds.ts",
    "../src/lib/tracker-model/constants/Statuses.ts",
    "../src/lib/tracker-model/@types/Decision.ts",
    "../src/lib/tracker-model/@types/Draft.ts",
    "../src/lib/tracker-model/@types/Incident.ts",
    "../src/lib/tracker-model/@types/Job.ts",
    "../src/lib/tracker-model/@types/Task.ts",
    "../src/lib/tracker-model/@types/Ticket.ts",
    "../src/lib/tracker-model/@types/TrackerProgress.ts",
    "../src/lib/tracker-model/@types/BoardChanges.ts",
    "../src/lib/tracker-model/@types/Concurrency.ts",
    "../src/lib/tracker-model/@types/Epic.ts",
    "../src/lib/tracker-model/@types/LifecycleLimits.ts",
    "../src/lib/tracker-model/@types/LifecycleStep.ts",
    "../src/lib/tracker-model/@types/LogRecord.ts",
    "../src/lib/tracker-model/@types/Pipeline.ts",
    "../src/lib/tracker-model/@types/ReviewRecord.ts",
    "../src/lib/tracker-model/@types/ReviewRound.ts",
    "../src/lib/tracker-model/AgentQuestions.ts",
    "../src/lib/tracker-model/Board.ts",
    "../src/lib/tracker-model/BoardRecords.ts",
    "../src/lib/tracker-model/BoardRefusal.ts",
    "../src/lib/tracker-model/Decisions.ts",
    "../src/lib/tracker-model/DispatchQueries.ts",
    "../src/lib/tracker-model/DisplayQueries.ts",
    "../src/lib/tracker-model/DraftContents.ts",
    "../src/lib/tracker-model/Drafts.ts",
    "../src/lib/tracker-model/EmptyProgress.ts",
    "../src/lib/tracker-model/Epics.ts",
    "../src/lib/tracker-model/GroupReleases.ts",
    "../src/lib/tracker-model/IncidentMoves.ts",
    "../src/lib/tracker-model/Incidents.ts",
    "../src/lib/tracker-model/JobControls.ts",
    "../src/lib/tracker-model/Jobs.ts",
    "../src/lib/tracker-model/LifecyclePolicy.ts",
    "../src/lib/tracker-model/Logger.ts",
    "../src/lib/tracker-model/MarkdownBodyEdit.ts",
    "../src/lib/tracker-model/MergeQueueMarks.ts",
    "../src/lib/tracker-model/MergeSlotClaims.ts",
    "../src/lib/tracker-model/ReadingBoard.ts",
    "../src/lib/tracker-model/ReviewBars.ts",
    "../src/lib/tracker-model/ReviewStatistics.ts",
    "../src/lib/tracker-model/TaskRows.ts",
    "../src/lib/tracker-model/TicketClaims.ts",
    "../src/lib/tracker-model/TicketDependencies.ts",
    "../src/lib/tracker-model/TicketEdits.ts",
    "../src/lib/tracker-model/TicketLinks.ts",
    "../src/lib/tracker-model/TicketMoves.ts",
    "../src/lib/tracker-model/TicketSettings.ts",
    "../src/lib/tracker-model/TokenCredits.ts",
    "../src/lib/tracker-model/TrackerChanges.ts",
    "../src/lib/tracker-model/constants/AgentSettings.ts",
