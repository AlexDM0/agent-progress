    "../src/lib/tracker-model/utils/DraftQuestionTreeUtil.ts",
    "../src/lib/tracker-model/utils/EpicUtil.ts",
    "../src/lib/tracker-model/utils/FailedPassUtil.ts",
    "../src/lib/tracker-model/utils/MergeQueueUtil.ts",
    "../src/lib/tracker-model/utils/NetworkDomainUtil.ts",
    "../src/lib/tracker-model/utils/NumberedIdUtil.ts",
    "../src/lib/tracker-model/utils/PipelineUtil.ts",
    "../src/lib/tracker-model/utils/ReleaseBundleUtil.ts",
    "../src/lib/tracker-model/utils/RoundVerdictUtil.ts",
    "../src/lib/tracker-model/utils/TaskRecordUtil.ts",
    "../src/lib/tracker-model/utils/TicketBodyHashUtil.ts",
    "../src/lib/tracker-model/utils/TicketChartUtil.ts",
    "../src/lib/tracker-model/utils/TicketDefaultsUtil.ts",
    "../src/lib/tracker-model/utils/TicketDependencyUtil.ts",
    "../src/lib/tracker-model/utils/TicketIdUtil.ts",
    "../src/lib/tracker-model/utils/TicketMoveUtil.ts",
    "../src/lib/tracker-model/utils/VocabularyUtil.ts"
  ],
  // The specs, the DOM specs and the test-only helpers stay out, so this program's surface is the Bridge that ships.
  "exclude": ["./**/*.spec.ts", "./**/*.dom.tsx", "./testing/**"]
}
